{
  "name": "claudetower",
  "version": "0.5.1",
  "private": true,
  "description": "Claude Code statusline CLI — shows project location, active model, context usage, cost, and rate limit",
  "bin": {
    "claudetower": "./bin/claudetower.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"test/display/**/*.test.js\"",
    "test:display": "node --test \"test/display/**/*.test.js\"",
    "test:accounts": "node --test \"test/accounts/**/*.test.js\"",
    "test:plugin": "node --test \"test/plugin/**/*.test.js\"",
    "build": "node scripts/build-sea.js",
    "lint": "eslint .",
    "lint:boundary": "node scripts/check-module-boundary.js",
    "verify": "npm run lint && npm run lint:boundary && npm run test:display && npm run test:plugin"
  },
  "license": "Apache-2.0",
  "author": "SoDam AI Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sodam-ai/ClaudeTower.git"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
